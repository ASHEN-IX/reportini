

#!/usr/bin/env node
import { program } from "commander";
import analyze from "../src/commands/analyze.js";

program
  .name("reportgen")
  .description("AI Report Generator CLI")
  .version("1.0.0");

program
  .command("analyze <file>")
  .option("--type <type>", "project type", "web")
  .option("--output <path>", "output folder", "./outputs")
  .action(analyze);

program.parse();